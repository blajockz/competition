{
  "name": "unified-competition-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unified multi-game competition platform: RoboPath, The Locked Phone and the 1v1 Huruf showdown, with live admin, big-screen and team screens.",
  "scripts": {
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "start:local": "node --env-file=.env server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  }
}
