# ---------------------------------------------------------------------------
# Unified Competition Platform — configuration
# Copy this file to .env and fill it in. Never commit .env.
# ---------------------------------------------------------------------------

# Your domain (DNS must point to this server). Caddy gets the HTTPS certificate.
DOMAIN=competition.example.com
# E-mail for Let's Encrypt certificate notices (optional but recommended)
ACME_EMAIL=you@example.com

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXX

# Shared secret between this server and the database functions.
# Must be the SAME value as in supabase/schema.sql (see README, step 2).
# Generate one with:  openssl rand -hex 32
APP_SYNC_SECRET=change-me-to-64-random-hex-characters

# --- Access codes (case-insensitive, at least 6 characters, all different) ---
ADMIN_ACCESS_CODE=ADM-XXXX-XXXX
HOST_ACCESS_CODE=HST-XXXX-XXXX

# Signs login sessions. Generate with:  openssl rand -hex 32
TOKEN_SECRET=change-me-to-64-random-hex-characters

# --- Optional ---
# Time zone of the event (the Locked Phone passcode is "tomorrow's date" there)
# Name shown on the public page and the screens
EVENT_NAME=N7 Kickoff Cup
EVENT_TIMEZONE=Africa/Casablanca
# Flag shown when a team cracks the Locked Phone
LOCKED_PHONE_FLAG=n7sec{3a572180f81e0ea8}
